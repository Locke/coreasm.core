// @require "STEP 0: lastStep = undef"
// @require "STEP 1: lastStep = 0"
// @refuse  "STEP 2: lastStep = 1"

// @maxsteps 10

CoreASM SingleStep

use StandardPlugins
use Time
use Number
use String

function lastStep : -> NUMBER

init initRule

rule initRule = {
	lastStep := stepcount
	print "STEP " + stepcount + ": lastStep = " + lastStep
}
