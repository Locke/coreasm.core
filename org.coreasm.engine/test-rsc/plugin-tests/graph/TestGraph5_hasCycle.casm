CoreASM Graph5_hasCycle

use Standard
use Graph
init Start

function g1 : -> GRAPH
function g2 : -> GRAPH

/*
 * @minsteps 1
 * @maxsteps 1
 *
 * @require "g1: ([a, b, c], [(a:b)=(a,b), (b:c)=(b,c), (a:c)=(a,c)])"
 * @require "g2: ([a, b, c], [(a:b)=(a,b), (b:c)=(b,c), (a:c)=(a,c), (c:a)=(c,a)])"
 * @require "hasCycle(g1): false"
 * @require "hasCycle(g2): true"
 */
rule Start =
	seqblock
		g1 := toGraph(["a", "b", "c"], [["a", "b"], ["b", "c"], ["a", "c"]])
		print "g1: " + g1

		g2 := toGraph(["a", "b", "c"], [["a", "b"], ["b", "c"], ["a", "c"], ["c", "a"]])
		print "g2: " + g2


		print "hasCycle(g1): " + hasCycle(g1)
		print "hasCycle(g2): " + hasCycle(g2)
	endseqblock
