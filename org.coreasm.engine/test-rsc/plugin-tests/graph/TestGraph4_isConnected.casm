CoreASM Graph4_isConnected

use Standard
use Graph
init Start

function g1 : -> GRAPH
function g2 : -> GRAPH

/*
 * @minsteps 1
 * @maxsteps 1
 *
 * @require "g1: ([a, b, c], [(a:b)=(a,b), (b:c)=(b,c), (a:c)=(a,c)])"
 * @require "g2: ([a, b, c, x, y], [(a:b)=(a,b), (b:c)=(b,c), (a:c)=(a,c), (x:y)=(x,y)])"
 * @require "isConnected(g1): true"
 * @require "isConnected(g2): false"
 */
rule Start =
	seqblock
		g1 := toGraph(["a", "b", "c"], [["a", "b"], ["b", "c"], ["a", "c"]])
		print "g1: " + g1

		g2 := toGraph(["a", "b", "c", "x", "y"], [["a", "b"], ["b", "c"], ["a", "c"], ["x", "y"]])
		print "g2: " + g2


		print "isConnected(g1): " + isConnected(g1)
		print "isConnected(g2): " + isConnected(g2)
	endseqblock
