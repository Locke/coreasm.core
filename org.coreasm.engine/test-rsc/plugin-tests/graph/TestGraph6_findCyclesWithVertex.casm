CoreASM Graph6_findCyclesWithVertex

use Standard
use Graph
init Start

function g1 : -> GRAPH
function g2 : -> GRAPH

/*
 * @minsteps 1
 * @maxsteps 1
 *
 * @require "g1: ([a, b, c], [(a:b)=(a,b), (b:c)=(b,c), (a:c)=(a,c), (c:a)=(c,a)])"
 * @require "g2: ([a, b, c, x, y], [(a:b)=(a,b), (b:c)=(b,c), (a:c)=(a,c), (c:a)=(c,a), (x:y)=(x,y), (y:x)=(y,x)])"
 * @require "findCyclesWithVertex(g1, a): {a, b, c}"
 * @require "findCyclesWithVertex(g2, a): {a, b, c}"
 * @require "findCyclesWithVertex(g2, x): {x, y}"
 */
rule Start =
	seqblock
		g1 := toGraph(["a", "b", "c"], [["a", "b"], ["b", "c"], ["a", "c"], ["c", "a"]])
		print "g1: " + g1

		g2 := toGraph(["a", "b", "c", "x", "y"], [["a", "b"], ["b", "c"], ["a", "c"], ["c", "a"], ["x", "y"], ["y", "x"]])
		print "g2: " + g2


		print "findCyclesWithVertex(g1, a): " + findCyclesWithVertex(g1, "a")

		print "findCyclesWithVertex(g2, a): " + findCyclesWithVertex(g2, "a")
		print "findCyclesWithVertex(g2, x): " + findCyclesWithVertex(g2, "x")
	endseqblock
